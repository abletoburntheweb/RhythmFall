; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RhythmFall"
run/main_scene="uid://5vghv31ksise"
config/use_custom_user_dir=true
config/custom_user_dir_name="RhythmFall"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://assets/app_icons/default_multi.png"
config/windows_native_icon="res://assets/app_icons/default_multi.ico"

[autoload]

PlayerDataManager="*res://logic/data/player_data_manager.gd"
TrackStatsManager="*res://logic/data/track_stats_manager.gd"
SettingsManager="*res://logic/core/settings_manager.gd"
LocaleManager="*res://logic/core/locale_manager.gd"
UpdateChecker="*res://logic/services/update_checker.gd"
GenerationProcessManager="*res://logic/services/generation_process_manager.gd"
ProfileMilestonesManager="*res://logic/data/profile_milestones_manager.gd"
MusicManager="*res://logic/services/music_manager.gd"
AppWindowManager="*res://logic/services/app_window_manager.gd"
SongLibrary="*res://logic/data/song_library.gd"
Console="*res://addons/console/console.gd"
DebugCommands="*res://addons/console/debug_commands.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/MusicMetadata/plugin.cfg", "res://addons/console/plugin.cfg")

[gui]

theme/custom_font="uid://dlkdapepenx4"

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=1
anti_aliasing/quality/msaa_2d=1
anti_aliasing/screen_space_roughness_limiter/enabled=false

[rhythmfall]

generation_api/host="127.0.0.1"
generation_api/port=5000
releases_url="https://github.com/abletoburntheweb/RhythmFall/releases"
